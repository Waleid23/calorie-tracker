#!/usr/bin/env python3
"""cal - a tiny calorie tracker.

Usage:
  cal add "food" 450   Save a food and its calories for today
  cal add "food"       Ask Claude to estimate the calories, then save
  cal today            List today's foods and the total
"""
import json
import subprocess
import sys
from datetime import date
from pathlib import Path

DATA_FILE = Path(__file__).resolve().parent / "calories.json"
MIN_ESTIMATE, MAX_ESTIMATE = 1, 5000


def load():
    if DATA_FILE.exists():
        return json.loads(DATA_FILE.read_text())
    return {}


def save(data):
    DATA_FILE.write_text(json.dumps(data, indent=2))


def add(food, calories, estimated=False):
    data = load()
    data.setdefault(date.today().isoformat(), []).append(
        {"food": food, "calories": calories}
    )
    save(data)
    note = " estimated by Claude" if estimated else ""
    print(f"Added {food} ({calories} cal{note})")


def estimate(food):
    """Ask claude -p for a calorie estimate; return it only if it passes our checks."""
    prompt = (
        f"Estimate the calories in this food: {food}\n"
        "Reply with only a single whole number. No words, units, or ranges."
    )
    try:
        result = subprocess.run(
            ["claude", "-p", prompt], capture_output=True, text=True, timeout=60
        )
    except FileNotFoundError:
        sys.exit("Error: 'claude' command not found. Give calories as a number instead.")
    except subprocess.TimeoutExpired:
        sys.exit("Error: Claude took too long to reply. Nothing saved.")
    if result.returncode != 0:
        sys.exit(f"Error: Claude failed: {result.stderr.strip()}. Nothing saved.")
    reply = result.stdout.strip()
    if not (reply.isascii() and reply.isdigit()):
        sys.exit(f"Error: Claude's reply was not a whole number: {reply!r}. Nothing saved.")
    calories = int(reply)
    if not MIN_ESTIMATE <= calories <= MAX_ESTIMATE:
        sys.exit(
            f"Error: Claude's estimate {calories} is outside "
            f"{MIN_ESTIMATE}-{MAX_ESTIMATE}. Nothing saved."
        )
    return calories


def today():
    entries = load().get(date.today().isoformat(), [])
    if not entries:
        print("Nothing logged today.")
        return
    for e in entries:
        print(f"{e['food']:<25} {e['calories']:>6}")
    print("-" * 32)
    print(f"{'Total':<25} {sum(e['calories'] for e in entries):>6}")


def main(args):
    if len(args) == 3 and args[0] == "add":
        try:
            calories = int(args[2])
        except ValueError:
            sys.exit("Calories must be a whole number.")
        add(args[1], calories)
    elif len(args) == 2 and args[0] == "add":
        add(args[1], estimate(args[1]), estimated=True)
    elif args == ["today"]:
        today()
    else:
        sys.exit(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv[1:])
